@model WebApp1.BLogicLayer.ViewModels.StudentViewModel

<h2>Delete Student</h2>

<p>Are you sure you want to delete this student?</p>

<div class="mb-3">
    <strong>Name:</strong>
    @Model.Name
</div>

<div class="mb-3">
    <strong>Address:</strong>
    @Model.Address
</div>

<form asp-controller="Student"
      asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>