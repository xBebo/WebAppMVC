@model WebApp1.BLogicLayer.ViewModels.CourseViewModel

<h2>Delete Course</h2>

<p>Are you sure you want to delete this course?</p>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Minimum Degree:</strong> @Model.MinDegree</p>

<form asp-controller="Course"
      asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>