@model WebApp1.BLogicLayer.ViewModels.DepartmentDetailsViewModel

<h2>Delete Department</h2>

<p>Are you sure you want to delete this department?</p>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Manager:</strong> @(Model.ManagerName ?? "N/A")</p>

<form asp-controller="Department"
      asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>