@model List<WebApp1.BLogicLayer.ViewModels.InstructorViewModel>

<h2>Instructor List</h2>

<a asp-controller="Instructor"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Add Instructor
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Address</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var instructor in Model)
        {
            <tr>
                <td>@instructor.Id</td>
                <td>@instructor.Name</td>
                <td>@instructor.Address</td>
                <td>@instructor.Salary</td>
                <td>
                    <a asp-controller="Instructor"
                       asp-action="Delete"
                       asp-route-id="@instructor.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>